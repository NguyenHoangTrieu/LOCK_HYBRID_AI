	(text "BOOT1 override jumper (replica of Nucleo MB1940 JP2)\nPlaced at JP2's exact mechanical offset from the Arduino header.\nBOOT1_SIM is LOCAL ONLY - Nucleo's real BOOT1 isn't on the Arduino\nconnector. Bridge a wire to the Nucleo's own JP2 pin 2 for a real override."
		(at 231 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "404da294-6567-4f33-93db-b746625bab3c")
	)
