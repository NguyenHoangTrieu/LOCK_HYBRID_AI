		)
		(property "Description" "Replica of the STM32N6 Nucleo-144 (MB1940) JP2 BOOT1 jumper (GND / BOOT1 / VDDIO, Header 3x1, 2.54mm), placed at the same mechanical offset from the Arduino header that JP2 has on the real Nucleo board (derived from ST's official mb1940-manufacturing.zip pick-and-place/ODB++ data). Pin2 (BOOT1_SIM) is a LOCAL net only - the real BOOT1 signal is not routed to the Nucleo's Arduino Uno R3 connector, so this jumper does not affect the actual MCU unless manually bridged to the real JP2."
			(at 250 60 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
