(footprint "INA228_Breakout_Socket"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "1x8 2.54mm female socket footprint for stacking the Adafruit INA228 breakout (PID 5832) directly onto this HAT, plus its two M2.5 mounting-hole locations at the correct relative offset. Pad pitch/order and hole spacing were measured from Adafruit's own Eagle source (github.com/adafruit/Adafruit-INA228-PCB): pin1=VCC, pin2=GND, pin3=SCL, pin4=SDA, pin5=VBUS, pin6=VIN-, pin7=VIN+, pin8=ALRT.")
	(tags "INA228 Adafruit 5832 power monitor breakout socket")
