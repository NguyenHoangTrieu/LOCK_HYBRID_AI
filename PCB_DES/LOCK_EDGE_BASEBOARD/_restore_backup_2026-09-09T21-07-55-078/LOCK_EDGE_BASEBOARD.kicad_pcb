	(footprint "Library:Arduino_Header"
		(layer "F.Cu")
		(uuid "365880e0-2e59-42f6-97bc-36af986b0a5a")
		(at 74.43 97.78)
		(descr "Arduino Uno-compatible pin header set (power/analog/digital rows only, no ICSP block, no board-outline artwork) - so this HAT plugs onto the FRDM-MCXN947's Arduino header (and stays mechanically compatible with an STM32N6 Nucleo's Arduino connector). Pad positions, including the tricky non-uniform D7/D8 gap, are taken as-is from Alarm-Siren/arduino-kicad-library's Arduino_Uno_R3_Shield footprint - only the decorative shield-outline graphics, ICSP block and mounting holes were stripped out.")
		(tags "Arduino Uno header FRDM-MCXN947 Nucleo")
